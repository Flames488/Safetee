# ── App ──────────────────────────────────────────────
ENV=development
APP_NAME=Safetee
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173,https://safetee.app

# ── Database (Postgres) ─────────────────────────────
# Local docker-compose value shown; swap for your managed Postgres/Supabase
# transaction-pooler URL in production (port 6543) and keep POOL_SIZE small.
DATABASE_URL=postgresql+asyncpg://safetee:safetee@postgres:5432/safetee
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ── Redis (Celery broker/backend + rate limiting) ───
REDIS_URL=redis://redis:6379/0

# ── SMS: Twilio (primary) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── SMS: Termii (Nigeria fallback) ──────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Safetee

# ── Push notifications ───────────────────────────────
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=ops@safetee.app

# ── Observability ────────────────────────────────────
SENTRY_DSN=

# ── Journey / SOS tuning ─────────────────────────────
SOS_CANCEL_WINDOW_SECONDS=5
JOURNEY_CHECKIN_GRACE_MINUTES=10
SOS_FANOUT_MAX_RETRIES=4

# ── Billing (Paystack) ───────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TRIAL_PERIOD_DAYS=14
# Where Paystack redirects the user after checkout, and where checkout
# links point the frontend — must match your actual frontend URL.
FRONTEND_URL=http://localhost:5173

# ── SOS evidence storage (Supabase) ─────────────────
# See app/services/storage/README.md for one-time bucket setup. Leave blank
# to disable evidence upload/confirm entirely (requests fail with a 502
# rather than silently no-op'ing).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=sos-evidence
EVIDENCE_SIGNED_URL_TTL_SECONDS=3600
EVIDENCE_MAX_AUDIO_CHUNKS=45
EVIDENCE_MAX_VIDEO_CHUNKS=45
EVIDENCE_MAX_PHOTOS=15
# Contact-facing share links (evidence + live-location tracking), separate
# from account access/refresh tokens.
SHARE_TOKEN_EXPIRE_HOURS=72

# ── Admin dashboard ──────────────────────────────────
# The phone number here is auto-promoted to super_admin on its next
# login/getMe call — leave blank and nobody is ever auto-promoted. The
# master password additionally gates every *mutating* admin action, on
# top of the super_admin role check (see app/api/deps.py).
SUPER_ADMIN_PHONE=
ADMIN_MASTER_PASSWORD=
