VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
# Must be the same keypair's public half as the backend's WEB_PUSH_PUBLIC_KEY —
# safe to expose in the browser bundle, that's what a VAPID public key is for.
VITE_VAPID_PUBLIC_KEY=
# Cloudflare Turnstile site key — safe to expose in the browser bundle
# (it's the public half; TURNSTILE_SECRET_KEY on the backend is the
# secret one). Leave blank to skip bot-check UI entirely (local dev).
VITE_TURNSTILE_SITE_KEY=
